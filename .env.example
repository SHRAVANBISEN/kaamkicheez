# Copy values into your LOCAL .env; restart Streamlit after changing them.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:5000/callback

# gemini (existing default), nvidia, or openai_compatible
LLM_PROVIDER=gemini
# Leave empty for the provider default. For NVIDIA, confirm availability first.
LLM_MODEL=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Custom/local server only: use LLM_PROVIDER=openai_compatible
# Example loopback base URL: http://127.0.0.1:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_JSON_MODE=false
